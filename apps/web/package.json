{
  "name": "@autoflow/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AutoFlow app — PWA and the shared UI of the Windows (Tauri) and Android (Capacitor) shells.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "i18n:translate": "tsx scripts/translate.ts"
  },
  "dependencies": {
    "@autoflow/core": "workspace:*",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "workbox-window": "^7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "playwright-core": "1.56.1",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
