<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through Android backup: flows sync only through AutoFlow's own end-to-end encryption,
     and Keystore-encrypted secrets could not be decrypted on another device anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
