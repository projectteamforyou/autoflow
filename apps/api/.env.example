# AutoFlow API configuration. Copy to .env for local development (never commit .env).

# PostgreSQL connection string (Railway: reference ${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autoflow

# HTTP port (Railway injects PORT automatically).
PORT=8080

# development | test | production
NODE_ENV=development

# Comma-separated CORS allowlist. Default when unset:
# https://autoflowmacro.com,http://localhost:5173,tauri://localhost,http://tauri.localhost,https://localhost
# APP_ORIGINS=https://autoflowmacro.com,http://localhost:5173,tauri://localhost,http://tauri.localhost,https://localhost

# Public web app URL used in email links (verify email, reset password, share links).
PUBLIC_APP_URL=https://autoflowmacro.com

# Transactional email via Resend (optional). Without it: console output in development,
# emails disabled (logged by category only) in production.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=AutoFlow <no-reply@your-domain.example>

# Number of trusted reverse proxies in front of the API (Railway edge = 1; 0 = use socket address).
# TRUST_PROXY_HOPS=1

# debug | info | warn | error | silent (default: info in production, debug otherwise)
# LOG_LEVEL=info

# Allow unverified accounts to publish to Atlas (default true = verification required).
# ATLAS_REQUIRE_VERIFIED_EMAIL=true

# Operators allowed into the in-app Admin page (payment keys, orders, Business entitlements).
# Comma-separated; the account's email must also be verified. Default: projectteamforyou@gmail.com
# ADMIN_EMAILS=projectteamforyou@gmail.com

# Key that payment secrets entered in the Admin page are encrypted with (AES-256-GCM, HKDF-derived).
# Required in production before any payment key can be saved; generate with: openssl rand -base64 32
# Changing it makes stored secrets unreadable (re-enter them in Admin). Payment keys themselves are
# NOT environment variables: PortOne (KCP) and PayPal keys are entered in the app's Admin page.
# SETTINGS_ENCRYPTION_KEY=
