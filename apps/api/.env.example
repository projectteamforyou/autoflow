# AutoFlow API configuration. Copy to .env for local development (never commit .env).

# PostgreSQL connection string (Railway: reference ${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autoflow

# HTTP port (Railway injects PORT automatically).
PORT=8080

# development | test | production
NODE_ENV=development

# Comma-separated CORS allowlist. Default when unset:
# https://autoflow-651.pages.dev,http://localhost:5173,tauri://localhost,http://tauri.localhost,https://localhost
# APP_ORIGINS=https://autoflow-651.pages.dev,http://localhost:5173,tauri://localhost,http://tauri.localhost,https://localhost

# Public web app URL used in email links (verify email, reset password, share links).
PUBLIC_APP_URL=https://autoflow-651.pages.dev

# Transactional email via Resend (optional). Without it: console output in development,
# emails disabled (logged by category only) in production.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=AutoFlow <no-reply@your-domain.example>

# Number of trusted reverse proxies in front of the API (Railway edge = 1; 0 = use socket address).
# TRUST_PROXY_HOPS=1

# debug | info | warn | error | silent (default: info in production, debug otherwise)
# LOG_LEVEL=info

# Allow unverified accounts to publish to Atlas (default true = verification required).
# ATLAS_REQUIRE_VERIFIED_EMAIL=true
